(kicad_pcb
  (version 20240108)
  (generator "eos_ecad_generate_products")
  (generator_version "8.0")

  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal)
    (2 "In2.Cu" signal)
    (3 "In3.Cu" signal)
    (4 "In4.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
