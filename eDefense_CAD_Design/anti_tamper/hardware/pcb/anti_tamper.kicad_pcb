    (legacy_teardrops no)
  )
  (paper "A4")

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal)
    (2 "In2.Cu" signal)
    (3 "In3.Cu" signal)
    (4 "In4.Cu" signal)
    (5 "In5.Cu" signal)
    (6 "In6.Cu" signal)
    (7 "In7.Cu" signal)
    (8 "In8.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
